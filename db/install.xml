<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="user/profile/field/repeatable/db" VERSION="2026030502"
    COMMENT="XMLDB file for profilefield_repeatable – copyright 2026 Anderson Blaine (anderson@blaine.com.br)"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="profilefield_repeatable_data" COMMENT="Repeatable profile field values grouped by set">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="dataid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="fieldid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="set_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="data" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="dataid_fk" TYPE="foreign" FIELDS="dataid" REFTABLE="user_info_data" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="dataid_setid_uix" UNIQUE="true" FIELDS="dataid, set_id"/>
        <INDEX NAME="fieldid_userid_ix" UNIQUE="false" FIELDS="fieldid, userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
