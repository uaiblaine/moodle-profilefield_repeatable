{{!
    @template profilefield_repeatable/display_plain
    @copyright 2026 Anderson Blaine (anderson@blaine.com.br)

    Repeatable profile field plain (non-accordion) display.

    Example context (json):
    {
        "sets": [
            {
                "setlabel": "Set 1",
                "parts": [
                    {"hasseparator": false, "key": "Name", "value": "John"},
                    {"hasseparator": true,  "key": "Role", "value": "Admin"}
                ]
            }
        ]
    }
}}
<ul class="profilefield-repeatable-display">
    {{#sets}}
        <li>
            <span class="profilefield-repeatable-display-set">{{setlabel}}: </span>
            {{#parts}}
                {{#hasseparator}} | {{/hasseparator}}
                <span class="profilefield-repeatable-display-key">{{key}}: </span>
                <span class="profilefield-repeatable-display-value">{{value}}</span>
            {{/parts}}
        </li>
    {{/sets}}
</ul>
