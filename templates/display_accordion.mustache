{{!
    @template profilefield_repeatable/display_accordion
    @copyright 2026 Anderson Blaine (anderson@blaine.com.br)

    Repeatable profile field display as accordion for profile pages.

    Example context (json):
    {
        "accordionid": "profilefield-repeatable-display-1-2-field",
        "tableinfo": "Information",
        "tablevalue": "Value",
        "items": [
            {
                "headingid": "heading-1",
                "collapseid": "collapse-1",
                "ariaexpanded": "true",
                "isopen": true,
                "isclosed": false,
                "hasprimaryvalue": true,
                "titlelabel": "Turma",
                "titlevalue": "101-A",
                "settitle": "Set 1",
                "hastable": true,
                "rows": [
                    {"label": "Diretoria", "value": "DIR-SP-Centro"}
                ],
                "hassync": true,
                "syncvalue": "Synchronised at: 15/10/23 - 08:30"
            }
        ]
    }
}}
<div class="accordion profilefield-repeatable-display-accordion" id="{{accordionid}}">
    {{#items}}
        <section class="accordion-item profilefield-repeatable-display-item">
            <h3 class="accordion-header profilefield-repeatable-display-header" id="{{headingid}}">
                <button
                    class="accordion-button profilefield-repeatable-accordion-button{{#isclosed}} collapsed{{/isclosed}}"
                    type="button"
                    aria-expanded="{{ariaexpanded}}"
                    aria-controls="{{collapseid}}"
                >
                    <span class="profilefield-repeatable-titletext">
                        {{#hasprimaryvalue}}
                            <span class="profilefield-repeatable-display-key">{{titlelabel}}:</span>
                            <span class="profilefield-repeatable-display-value">{{titlevalue}}</span>
                        {{/hasprimaryvalue}}
                        {{^hasprimaryvalue}}
                            <span class="profilefield-repeatable-display-value">{{settitle}}</span>
                        {{/hasprimaryvalue}}
                    </span>
                </button>
            </h3>
            <div
                id="{{collapseid}}"
                class="accordion-collapse collapse{{#isopen}} show{{/isopen}} profilefield-repeatable-accordion-collapse"
                aria-labelledby="{{headingid}}"
                role="region"
                {{#isclosed}}hidden{{/isclosed}}
            >
                <div class="accordion-body profilefield-repeatable-accordion-body">
                    {{#hastable}}
                        <div class="table-responsive profilefield-repeatable-display-table-wrap">
                            <table class="table table-striped table-hover mb-3 profilefield-repeatable-display-table">
                                <thead>
                                    <tr>
                                        <th scope="col">{{tableinfo}}</th>
                                        <th scope="col">{{tablevalue}}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#rows}}
                                        <tr>
                                            <td>{{label}}</td>
                                            <td>{{value}}</td>
                                        </tr>
                                    {{/rows}}
                                </tbody>
                            </table>
                        </div>
                    {{/hastable}}
                    {{#hassync}}
                        <div class="text-end text-muted small profilefield-repeatable-display-sync">{{syncvalue}}</div>
                    {{/hassync}}
                </div>
            </div>
        </section>
    {{/items}}
</div>
