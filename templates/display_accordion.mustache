{{!
    @template profilefield_repeatable/display_accordion
    @copyright 2026 Anderson Blaine (anderson@blaine.com.br)

    Repeatable profile field display as native <details>/<summary> accordion
    with semantic <dl> body, optional collapsed-only subline and sync footer.

    Example context (json):
    {
        "accordionid": "profilefield-repeatable-display-1-2-field",
        "fieldname": "Atribuições",
        "hasfieldname": true,
        "items": [
            {
                "bodyid": "profilefield-repeatable-display-1-2-field-body-1",
                "isopen": true,
                "hasprimaryvalue": true,
                "titlevalue": "Administraçao - 3ª serie A integral",
                "hassubline": true,
                "parts": [
                    {"value": "Gestão de Operações", "isfirst": true},
                    {"value": "Martha Calixto Cazagrande", "isfirst": false}
                ],
                "hasrows": true,
                "rows": [
                    {"label": "Disciplina", "value": "Gestão de Operações"},
                    {"label": "Escola", "value": "Martha Calixto Cazagrande"}
                ],
                "hassync": true,
                "syncvalue": "Synchronised at: 15/10/23 - 08:30"
            }
        ]
    }
}}
<section
    class="profilefield-repeatable-display-accordion"
    id="{{accordionid}}"
    {{#hasfieldname}}aria-label="{{fieldname}}"{{/hasfieldname}}
>
    {{#items}}
        <details class="profilefield-repeatable-item"{{#isopen}} open{{/isopen}}>
            <summary class="profilefield-repeatable-summary" aria-controls="{{bodyid}}">
                <h3 class="profilefield-repeatable-title">{{titlevalue}}</h3>
                {{#hassubline}}
                    <hr class="profilefield-repeatable-title-divider" aria-hidden="true">
                    <div class="profilefield-repeatable-subline">
                        {{#parts}}
                            {{^isfirst}}<span class="profilefield-repeatable-subline-dot" aria-hidden="true">·</span>{{/isfirst}}
                            <span class="profilefield-repeatable-subline-item{{#isfirst}} profilefield-repeatable-subline-primary{{/isfirst}}">{{value}}</span>
                        {{/parts}}
                    </div>
                {{/hassubline}}
            </summary>
            <div class="profilefield-repeatable-body" id="{{bodyid}}">
                {{#hasrows}}
                    <dl class="profilefield-repeatable-dl">
                        {{#rows}}
                            <dt>{{label}}</dt>
                            <dd>{{value}}</dd>
                        {{/rows}}
                    </dl>
                {{/hasrows}}
                {{#hassync}}
                    <p class="profilefield-repeatable-sync">{{syncvalue}}</p>
                {{/hassync}}
            </div>
        </details>
    {{/items}}
</section>
