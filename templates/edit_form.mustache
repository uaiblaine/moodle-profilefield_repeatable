{{!
    @template profilefield_repeatable/edit_form
    @copyright 2026 Anderson Blaine (anderson@blaine.com.br)

    Repeatable profile field edit form table.

    The wrapper is described by the error region of the form group that carries the field's
    value (errorid), so a server-side validation error is announced with the widget. That region
    lives outside this template, so the example context leaves errorid out.

    Example context (json):
    {
        "fieldlabel": "Repeatable test",
        "labelid": "profilefield-repeatable-1-0-repeatable_test-label",
        "wrapperid": "profilefield-repeatable-1-0-repeatable_test",
        "setcolumn": "SET",
        "actioncolumn": "ACTION",
        "addnewset": "Add new set",
        "subitems": [
            {"name": "Name"},
            {"name": "Role"}
        ]
    }
}}
<label id="{{labelid}}" class="d-block mb-2">{{fieldlabel}}</label>
<div id="{{wrapperid}}" class="profilefield-repeatable-wrapper" data-region="repeatable-wrapper"
    role="group" aria-labelledby="{{labelid}}"{{#errorid}} aria-describedby="{{errorid}}"{{/errorid}}>
    <div class="profilefield-repeatable-table-wrapper border rounded" data-region="table-wrapper">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th scope="col" class="position-sticky profilefield-repeatable-sticky-head">{{setcolumn}}</th>
                    {{#subitems}}
                        <th scope="col" class="position-sticky profilefield-repeatable-sticky-head">{{name}}</th>
                    {{/subitems}}
                    <th scope="col" class="position-sticky profilefield-repeatable-sticky-head text-center">{{actioncolumn}}</th>
                </tr>
            </thead>
            <tbody data-region="sets" class="profilefield-repeatable-sets">
            </tbody>
        </table>
    </div>
    <button type="button" class="btn btn-secondary mt-2" data-action="addset">{{addnewset}}</button>
</div>
